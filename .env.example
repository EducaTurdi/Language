# Crie um projeto gratuito em https://supabase.com e cole as chaves abaixo.
# Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Chave secreta (Project Settings > API > service_role). NUNCA exponha no
# frontend nem faça commit dela — fica só nas variáveis de ambiente do
# servidor/Vercel. É usada para criar contas e resetar senhas.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
